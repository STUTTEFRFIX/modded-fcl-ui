+            if (file == null || file.isOld()) {
+                continue;
+            }
+            files.add(file);
+            RemoteMod remote = object.getRemoteMod();
+            if (remote != null) {
+                knownRemote.put(file.getFileName(), remote);
+            }
+        }
+        if (files.isEmpty()) {
+            Toast.makeText(getContext(), R.string.mods_graph_empty, Toast.LENGTH_SHORT).show();
+            return;
+        }
+        new ModGraphDialog(getContext(), files, knownRemote).show();
