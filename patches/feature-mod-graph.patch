+        for (ModInfoObject object : allMods) {
+            LocalModFile file = object.getModInfo();
+            if (file == null || file.isOld()) {
+                continue;
+            }
+            inputs.add(ModGraphBuilder.Input.from(file));
+        }
+        ModGraph graph = ModGraphBuilder.build(inputs);
+        if (graphSummary == null) {
+            return;
