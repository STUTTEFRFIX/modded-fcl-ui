diff --git a/FCL/src/main/java/com/tungsten/fcl/activity/OnboardingActivity.kt b/FCL/src/main/java/com/tungsten/fcl/activity/OnboardingActivity.kt
new file mode 100644
index 00000000..3998ea02
--- /dev/null
+++ b/FCL/src/main/java/com/tungsten/fcl/activity/OnboardingActivity.kt
@@ -0,0 +1,136 @@
+package com.tungsten.fcl.activity
+
+import android.content.Context
+import android.content.Intent
+import android.os.Bundle
+import android.view.View
+import android.view.ViewGroup
+import android.widget.Button
+import android.widget.FrameLayout
+import android.widget.ImageButton
+import android.widget.LinearLayout
+import android.widget.ViewFlipper
+import androidx.core.content.edit
+import androidx.core.view.ViewCompat
+import androidx.core.view.WindowCompat
+import androidx.core.view.WindowInsetsCompat
+import androidx.core.view.updatePadding
+import com.tungsten.fcl.R
+import com.tungsten.fcllibrary.component.FCLActivity
+
+/**
+ * 首次启动引导：三屏竖屏纸质页，看完进主界面。
+ *
+ * 文案是产品原文，逐字不改（见 docs/20/首次启动引导/README.md §2.1）。
+ * 样式全部用 onb_* 资源，不接 [com.tungsten.fcllibrary.component.theme.ThemeEngine] 的自动取色，
+ * 避免新界面被旧主题的自动着色带走（docs/19 §4.6）。
+ */
+class OnboardingActivity : FCLActivity() {
+
+    companion object {
+        /** Splash 把本该给 MainActivity 的 extras 暂存在这里，引导结束后原样转发 */
+        const val EXTRA_NEXT_EXTRAS = "onboarding_next_extras"
+
+        private const val PREFS = "launcher"
+        private const val KEY_DONE = "onboarding_done"
+
+        private const val PAGE_COUNT = 3
+
+        /** 是否还需要展示引导（只跑一次） */
+        @JvmStatic
+        fun shouldShow(context: Context): Boolean =
+            !context.getSharedPreferences(PREFS, Context.MODE_PRIVATE)
+                .getBoolean(KEY_DONE, false)
+    }
+
+    private lateinit var pager: ViewFlipper
+    private lateinit var nextButton: Button
+    private lateinit var backButton: Button
+    private lateinit var dots: List<View>
+
+    private var index = 0
+
+    override fun onCreate(savedInstanceState: Bundle?) {
+        super.onCreate(savedInstanceState)
+        setContentView(R.layout.activity_onboarding)
+
+        // 浅纸面配深色状态栏图标
+        WindowCompat.getInsetsController(window, window.decorView).apply {
+            isAppearanceLightStatusBars = true
+            isAppearanceLightNavigationBars = true
+        }
+        // 全屏与否由 FCLActivity 决定，这里只保证内容不被刘海/手势条压住
+        val root = findViewById<FrameLayout>(R.id.onb_root)
+        ViewCompat.setOnApplyWindowInsetsListener(root) { view, insets ->
+            val bars = insets.getInsets(
+                WindowInsetsCompat.Type.systemBars() or WindowInsetsCompat.Type.displayCutout()
+            )
+            view.updatePadding(bars.left, bars.top, bars.right, bars.bottom)
+            insets
+        }
+
+        pager = findViewById(R.id.onb_pager)
+        pager.setInAnimation(this, R.anim.onboarding_in)
+        pager.setOutAnimation(this, R.anim.onboarding_out)
+
+        nextButton = findViewById(R.id.onb_next)
+        backButton = findViewById(R.id.onb_back)
+
+        val dotContainer = findViewById<LinearLayout>(R.id.onb_dots)
+        dots = (0 until dotContainer.childCount).map { dotContainer.getChildAt(it) }
+
+        nextButton.setOnClickListener {
+            if (index < PAGE_COUNT - 1) go(index + 1) else finishOnboarding()
+        }
+        backButton.setOnClickListener {
+            if (index > 0) go(index - 1)
+        }
+        findViewById<ImageButton>(R.id.onb_close).setOnClickListener { finishOnboarding() }
+
+        applyPage()
+    }
+
+    private fun go(target: Int) {
+        if (target == index) return
+        if (target > index) pager.showNext() else pager.showPrevious()
+        index = target
+        applyPage()
+    }
+
+    private fun applyPage() {
+        nextButton.setText(
+            if (index == PAGE_COUNT - 1) R.string.onboarding_start else R.string.onboarding_next
+        )
+        backButton.visibility = if (index == 0) View.GONE else View.VISIBLE
+
+        val dotSize = resources.getDimensionPixelSize(R.dimen.onb_dot)
+        val dotOnSize = resources.getDimensionPixelSize(R.dimen.onb_dot_on_w)
+        dots.forEachIndexed { i, dot ->
+            val on = i == index
+            val lp = dot.layoutParams as ViewGroup.MarginLayoutParams
+            lp.width = if (on) dotOnSize else dotSize
+            dot.layoutParams = lp
+            dot.setBackgroundResource(
+                if (on) R.drawable.onboarding_dot_on else R.drawable.onboarding_dot_off
+            )
+        }
+    }
+
+    /** 引导结束：记一次标记，按原计划进主界面 */
+    private fun finishOnboarding() {
+        getSharedPreferences(PREFS, Context.MODE_PRIVATE).edit { putBoolean(KEY_DONE, true) }
+
+        val forwarded = intent.getBundleExtra(EXTRA_NEXT_EXTRAS)
+        val target = Intent(this, MainActivity::class.java)
+        if (forwarded != null) target.putExtras(forwarded)
+
+        startActivity(target)
+        overridePendingTransition(0, 0)
+        finish()
+    }
+
+    @Deprecated("引导页只有三级，返回键等同于返回上一屏")
+    override fun onBackPressed() {
+        if (index > 0) go(index - 1) else finishOnboarding()
+    }
+}
diff --git a/FCL/src/main/java/com/tungsten/fcl/activity/SplashActivity.kt b/FCL/src/main/java/com/tungsten/fcl/activity/SplashActivity.kt
index efe0eea7..aafa41ec 100644
--- a/FCL/src/main/java/com/tungsten/fcl/activity/SplashActivity.kt
+++ b/FCL/src/main/java/com/tungsten/fcl/activity/SplashActivity.kt
@@ -165,10 +165,20 @@ class SplashActivity : FCLActivity() {
                     }
                 }
             }
-            startActivity(
-                handleModpack(Intent(this@SplashActivity, MainActivity::class.java)),
-                ActivityOptionsCompat.makeCustomAnimation(this@SplashActivity, 0, 0).toBundle()
-            )
+            // 首次启动先走三屏引导；引导结束由 OnboardingActivity 拉起 MainActivity
+            val target = handleModpack(Intent(this@SplashActivity, MainActivity::class.java))
+            if (OnboardingActivity.shouldShow(this@SplashActivity)) {
+                startActivity(
+                    Intent(this@SplashActivity, OnboardingActivity::class.java).apply {
+                        target.extras?.let { putExtra(OnboardingActivity.EXTRA_NEXT_EXTRAS, it) }
+                    }
+                )
+            } else {
+                startActivity(
+                    target,
+                    ActivityOptionsCompat.makeCustomAnimation(this@SplashActivity, 0, 0).toBundle()
+                )
+            }
             finish()
         }
     }
