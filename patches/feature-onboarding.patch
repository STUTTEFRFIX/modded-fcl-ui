diff --git a/FCL/src/main/res/layout/activity_onboarding.xml b/FCL/src/main/res/layout/activity_onboarding.xml
new file mode 100644
index 00000000..f0f40917
--- /dev/null
+++ b/FCL/src/main/res/layout/activity_onboarding.xml
@@ -0,0 +1,122 @@
+<?xml version="1.0" encoding="utf-8"?>
+<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
+    android:id="@+id/onb_root"
+    android:layout_width="match_parent"
+    android:layout_height="match_parent"
+    android:background="@drawable/bg_onboarding_paper">
+
+    <!-- 纸纹：平铺的极淡颗粒，叠在纸色上 -->
+    <View
+        android:layout_width="match_parent"
+        android:layout_height="match_parent"
+        android:background="@drawable/bg_onboarding_texture"
+        android:alpha="0.55"
+        android:importantForAccessibility="no" />
+
+    <LinearLayout
+        android:layout_width="match_parent"
+        android:layout_height="match_parent"
+        android:orientation="vertical"
+        android:paddingStart="@dimen/onb_inset"
+        android:paddingEnd="@dimen/onb_inset"
+        android:paddingTop="8dp"
+        android:paddingBottom="24dp">
+
+        <!-- 顶栏：纯图形关闭 -->
+        <FrameLayout
+            android:layout_width="match_parent"
+            android:layout_height="@dimen/onb_touch">
+
+            <ImageButton
+                android:id="@+id/onb_close"
+                android:layout_width="@dimen/onb_touch"
+                android:layout_height="@dimen/onb_touch"
+                android:layout_gravity="end|center_vertical"
+                android:background="?attr/selectableItemBackgroundBorderless"
+                android:contentDescription="@string/onboarding_skip"
+                android:scaleType="center"
+                android:src="@drawable/ic_onboarding_close" />
+        </FrameLayout>
+
+        <ViewFlipper
+            android:id="@+id/onb_pager"
+            android:layout_width="match_parent"
+            android:layout_height="0dp"
+            android:layout_weight="1">
+
+            <include layout="@layout/onboarding_page_welcome" />
+            <include layout="@layout/onboarding_page_community" />
+            <include layout="@layout/onboarding_page_credits" />
+        </ViewFlipper>
+
+        <LinearLayout
+            android:id="@+id/onb_dots"
+            android:layout_width="match_parent"
+            android:layout_height="wrap_content"
+            android:orientation="horizontal"
+            android:gravity="center"
+            android:layout_marginTop="8dp"
+            android:layout_marginBottom="16dp"
+            android:importantForAccessibility="no">
+
+        <View
+            android:layout_width="@dimen/onb_dot"
+            android:layout_height="@dimen/onb_dot"
+            android:layout_marginStart="0dp"
+            android:layout_marginEnd="6dp"
+            android:background="@drawable/onboarding_dot_on" />
+        <View
+            android:layout_width="@dimen/onb_dot"
+            android:layout_height="@dimen/onb_dot"
+            android:layout_marginStart="6dp"
+            android:layout_marginEnd="6dp"
+            android:background="@drawable/onboarding_dot_off" />
+        <View
+            android:layout_width="@dimen/onb_dot"
+            android:layout_height="@dimen/onb_dot"
+            android:layout_marginStart="6dp"
+            android:layout_marginEnd="6dp"
+            android:background="@drawable/onboarding_dot_off" />
+        </LinearLayout>
+
+        <LinearLayout
+            android:layout_width="match_parent"
+            android:layout_height="wrap_content"
+            android:orientation="horizontal"
+            android:gravity="center_vertical">
+
+            <Button
+                android:id="@+id/onb_back"
+                android:layout_width="wrap_content"
+                android:layout_height="@dimen/onb_action_height"
+                android:minWidth="88dp"
+                android:minHeight="0dp"
+                android:layout_marginEnd="12dp"
+                android:background="@drawable/bg_onboarding_ghost"
+                android:stateListAnimator="@null"
+                android:text="@string/onboarding_back"
+                android:textAllCaps="false"
+                android:textColor="@color/onb_ink_2"
+                android:textSize="14sp"
+                android:fontFamily="sans-serif-medium"
+                android:letterSpacing="0"
+                android:visibility="gone" />
+
+            <Button
+                android:id="@+id/onb_next"
+                android:layout_width="0dp"
+                android:layout_height="@dimen/onb_action_height"
+                android:layout_weight="1"
+                android:minWidth="0dp"
+                android:minHeight="0dp"
+                android:background="@drawable/bg_onboarding_primary"
+                android:stateListAnimator="@null"
+                android:text="@string/onboarding_next"
+                android:textAllCaps="false"
+                android:textColor="@color/onb_on_accent"
+                android:textSize="16sp"
+                android:fontFamily="sans-serif-medium"
+                android:letterSpacing="0" />
+        </LinearLayout>
+    </LinearLayout>
+</FrameLayout>
diff --git a/FCL/src/main/res/layout/onboarding_page_community.xml b/FCL/src/main/res/layout/onboarding_page_community.xml
