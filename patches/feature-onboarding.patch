+    android:layout_width="match_parent"
+    android:layout_height="match_parent"
+    android:orientation="vertical"
+    android:gravity="center"
+    android:paddingStart="@dimen/onb_inset"
+    android:paddingEnd="@dimen/onb_inset">
+
+    <ImageView
+        android:layout_width="@dimen/onb_art_community_w"
+        android:layout_height="wrap_content"
+        android:adjustViewBounds="true"
+        android:src="@drawable/onboarding_art_community"
+        android:importantForAccessibility="no" />
+
+    <TextView
+        android:layout_width="wrap_content"
+        android:layout_height="wrap_content"
+        android:layout_gravity="center_horizontal"
+        android:layout_marginTop="32dp"
+        android:maxWidth="@dimen/onb_title_max_w"
+        android:gravity="center"
+        android:text="@string/onboarding_title_community"
+        android:textColor="@color/onb_ink"
+        android:textSize="32sp"
+        android:fontFamily="sans-serif-medium"
+        android:lineSpacingExtra="8sp"
+        android:includeFontPadding="false"
+        android:breakStrategy="balanced" />
+</LinearLayout>
